{
  "name": "reui",
  "version": "0.0.0",
  "private": true,
  "description": "ReUI — FiveM frontend plugin framework (monorepo root)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:cov": "pnpm -r --workspace-concurrency=1 run test:cov",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
