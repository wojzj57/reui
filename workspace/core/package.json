{
  "name": "@reui/core",
  "version": "0.0.0",
  "private": true,
  "description": "ReUI iframe-side SDK — postMessage protocol client (RFC-001).",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:types": "vitest run --typecheck.only",
    "size": "size-limit",
    "lint": "echo \"(no lint configured yet)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reui/interface": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.16.13",
    "@vitest/coverage-v8": "^2.1.4",
    "jsdom": "^25.0.1",
    "size-limit": "^11.1.6",
    "@size-limit/preset-small-lib": "^11.1.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^3.23.8"
  }
}
